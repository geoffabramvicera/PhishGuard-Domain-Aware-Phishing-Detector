{
  "manifest_version": 3,
  "name": "PhishGuard, Domain Aware URL Checker",
  "short_name": "PhishGuard",
  "version": "1.0.0",
  "description": "Analyze the current browser tab or a pasted URL with your local domain-aware phishing detection model.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "Scan this URL with PhishGuard",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
